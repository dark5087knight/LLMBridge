# Service settings
ULIL_LOG_LEVEL=INFO
ULIL_LOG_FORMAT=console
ULIL_MAX_REQUEST_BYTES=1000000
ULIL_MAX_TOTAL_TIMEOUT_S=300
ULIL_MAX_ATTEMPTS_CAP=3

# Inbound caller authentication (empty list = auth disabled)
# Example: ULIL_API_KEYS=["secret-key-1","secret-key-2"]
ULIL_API_KEYS=[]

# Optional path to YAML config file
# ULIL_CONFIG_FILE=config/providers.example.yaml

# Provider Credentials & Configuration
ULIL_PROVIDERS__OPENAI__ENABLED=true
ULIL_PROVIDERS__OPENAI__API_KEY=sk-...
ULIL_PROVIDERS__OPENAI__TIMEOUT_S=60

ULIL_PROVIDERS__GROQ__ENABLED=true
ULIL_PROVIDERS__GROQ__API_KEY=gsk_...
ULIL_PROVIDERS__GROQ__TIMEOUT_S=60

ULIL_PROVIDERS__GEMINI__ENABLED=true
ULIL_PROVIDERS__GEMINI__API_KEY=AIzaSy...
ULIL_PROVIDERS__GEMINI__TIMEOUT_S=60

ULIL_PROVIDERS__OLLAMA__ENABLED=true
ULIL_PROVIDERS__OLLAMA__BASE_URL=http://localhost:11434
ULIL_PROVIDERS__OLLAMA__TIMEOUT_S=180
ULIL_PROVIDERS__OLLAMA__MAX_CONCURRENCY=4
